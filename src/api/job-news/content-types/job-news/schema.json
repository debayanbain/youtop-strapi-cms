{
  "kind": "collectionType",
  "collectionName": "job_news_items",
  "info": {
    "singularName": "job-news",
    "pluralName": "job-news-items",
    "displayName": "Job News"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "content": {
      "type": "richtext"
    },
    "published_date": {
      "type": "date"
    },
    "source_link": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "exam",
        "job",
        "result",
        "notice"
      ],
      "default": "job"
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "source_meta": {
      "type": "component",
      "component": "shared.source-meta",
      "repeatable": false
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}
