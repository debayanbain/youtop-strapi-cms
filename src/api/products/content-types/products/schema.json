{
  "kind": "collectionType",
  "collectionName": "products_manage",
  "info": {
    "singularName": "products",
    "pluralName": "products-manage",
    "displayName": "Products"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "ebook",
        "note",
        "course",
        "mocktest"
      ],
      "required": true
    },
    "class": {
      "type": "integer",
      "min": 5,
      "max": 12
    },
    "subject": {
      "type": "enumeration",
      "enum": [
        "Physics",
        "Chemistry",
        "Mathematics",
        "Biology",
        "Science",
        "Social Science",
        "History",
        "Geography",
        "English",
        "Bengali",
        "Hindi",
        "Computer Science",
        "All Subjects"
      ]
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "short_description": {
      "type": "text"
    },
    "price": {
      "type": "biginteger",
      "required": true
    },
    "old_price": {
      "type": "biginteger"
    },
    "author_name": {
      "type": "string"
    },
    "badge": {
      "type": "string",
      "maxLength": 40
    },
    "is_best_seller": {
      "type": "boolean",
      "default": false
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "biginteger"
    }
  }
}
