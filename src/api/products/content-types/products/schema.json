{
  "kind": "collectionType",
  "collectionName": "products_manage",
  "info": {
    "singularName": "products",
    "pluralName": "products-manage",
    "displayName": "Products"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "ebook",
        "note",
        "course",
        "mocktest"
      ]
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "short_description": {
      "type": "text"
    },
    "price": {
      "type": "biginteger"
    },
    "old_price": {
      "type": "biginteger"
    },
    "author_name": {
      "type": "string"
    },
    "badge": {
      "type": "string"
    },
    "is_best_seller": {
      "type": "boolean"
    },
    "is_featured": {
      "type": "boolean"
    },
    "active": {
      "type": "boolean"
    },
    "sort_order": {
      "type": "biginteger"
    }
  }
}
