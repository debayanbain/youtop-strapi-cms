    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "short_description": {
      "type": "text"
    },
    "badge_date": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}
