{
  "kind": "collectionType",
  "collectionName": "updates",
  "info": {
    "singularName": "update",
    "pluralName": "updates",
    "displayName": "Updates"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "exam",
        "job",
        "result",
        "scholarship"
      ],
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "publish_date": {
      "type": "date",
      "required": true
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}
